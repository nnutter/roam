amends
  "package://github.com/nnutter/hk-config/releases/download/v2.10.0-3/hk-config@2.10.0-3#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl" as Hk
import
  "package://github.com/nnutter/hk-config/releases/download/v2.10.0-3/hk-config@2.10.0-3#/Builtins.pkl"
  as Extra

steps {
  ["gomod_tidy"] = Hk.gomod_tidy
  ["go_fumpt"] = Hk.go_fumpt
  ["go_imports"] = Extra.go_imports
  ["go_fix"] = Hk.go_fix
  ["constable"] = Extra.constable
  ["errcheck"] = Hk.err_check
  ["staticcheck"] = Hk.staticcheck
  ["testifylint"] = Extra.testifylint
  ["go_check_sumtype"] = Extra.go_check_sumtype
  ["go_vet"] = Hk.go_vet
  ["gosec"] = Extra.go_sec
  ["govulncheck"] = Hk.go_vuln_check
  ["nilaway"] = Extra.nilaway
  ["mdlint"] = Extra.mdlint
  ["pkl_format"] = Hk.pkl_format
  ["pkl"] = Hk.pkl
  ["tombi_format"] = Hk.tombi_format
  ["tombi"] = Hk.tombi
  ["yamlfmt"] = Hk.yamlfmt
  ["gitleaks"] = Hk.gitleaks
}
